{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"types": ["vitest/globals"]
	},
	"include": ["src", "tests"]
}
