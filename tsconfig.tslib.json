{
   "compilerOptions": {
      "forceConsistentCasingInFileNames": true,
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "sourceMap": true,
      "declaration": true,
      "declarationMap": true,
      "noEmit": true,
      "skipLibCheck": true,
      "allowJs": false,
      "types": [],
      "baseUrl": ".",
      "paths": {}
   },
   "include": ["src"]
}
