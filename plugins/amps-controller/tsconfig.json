{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@helios/sdk": ["../libs/sdk/src/index.ts"]
		},
		"types": ["vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src"]
}
