{
   "name": "eog-client",
   "version": "1.0.0",
   "main": "./dist/eog-client.cjs.js",
   "module": "./dist/eog-client.es.js",
   "types": "./dist/index.d.ts",
   "repository": "https://github.com/vickykatoch/eog-client.git",
   "author": "Balwinder Katoch <vickykatoch@yahoo.com>",
   "license": "MIT",
   "type": "module",
   "devDependencies": {
      "@eslint/js": "^9.37.0",
      "@types/node": "22.9.0",
      "@typescript-eslint/eslint-plugin": "^8.46.0",
      "@typescript-eslint/parser": "^8.46.0",
      "@vitest/coverage-istanbul": "3.2.4",
      "@vitest/coverage-v8": "3.2.4",
      "c8": "^10.1.3",
      "eslint": "^9.0.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.4",
      "jsdom": "^27.0.0",
      "prettier": "^3.6.2",
      "rimraf": "^6.0.1",
      "typescript": "^5.5.4",
      "typescript-eslint": "^8.46.0",
      "vite": "^7.1.9",
      "vite-plugin-dts": "^4.5.4",
      "vitest": "^3.2.4"
   },
   "peerDependencies": {},
   "dependencies": {},
   "scripts": {
      "dev": "vite build --watch",
      "build": "vite build",
      "test": "vitest",
      "test:run": "vitest run",
      "coverage": "vitest run --coverage",
      "clean": "rimraf dist coverage || rm -rf dist coverage",
      "lint": "eslint . --ext .ts,.tsx",
      "lint:fix": "eslint . --ext .ts,.tsx --fix",
      "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" && prettier --write \"tests/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
      "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" && prettier --check \"tests/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
   },
   "exports": {
      ".": {
         "require": "./dist/websocket-lib.cjs.js",
         "import": "./dist/websocket-lib.es.js"
      }
   }
}
