{
	"name": "helios",
	"private": true,
	"type": "module",
	"workspaces": [
		"shell",
		"libs/*",
		"plugins/*"
	],
	"scripts": {
		"dev": "npm run -w shell dev",
		"build": "npm run -w shell build",
		"test": "npm run --workspaces --if-present test",
		"test:watch": "npm run --workspaces --if-present test:watch",
		"test:ui": "npm run --workspaces --if-present test:ui",
		"test:coverage": "npm run --workspaces --if-present test:coverage && npm run coverage:merge",
		"coverage:merge": "node scripts/merge-coverage.js",
		"coverage:view": "open coverage/index.html",
		"test:shell": "npm run test --workspace=shell",
		"test:plugins": "npm run test --workspace=@helios/amps-controller",
		"test:libs": "npm run test --workspace=@helios/amps-client",
		"format": "biome check --write",
		"format:check": "biome check",
		"lint": "biome lint",
		"lint:check": "biome lint --error-on-warnings",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"biome check --write --no-errors-on-unmatched",
			"biome lint --error-on-warnings --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/node": "^20.19.27",
		"@vitest/coverage-v8": "^2.1.9",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11",
		"vite": "^7.2.4",
		"vitest": "^2.1.9"
	}
}
