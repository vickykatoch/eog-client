{
   "name": "my-monorepo",
   "private": true,
   "workspaces": [
      "packages/*",
      "apps/*"
   ],
   "scripts": {
      "build": "npm run build -ws",
      "dev": "npm run dev -w apps/view-hub",
      "test": "npm run test -ws",
      "test:watch": "npm run test:watch -ws",
      "test:eog-client": "vitest --dir packages/eog-client",
      "coverage": "vitest run --coverage"
   },
   "devDependencies": {
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.0",
      "@testing-library/user-event": "^14.6.1",
      "@types/node": "^22.18.10",
      "@vitejs/plugin-react": "^5.0.4",
      "@vitest/coverage-v8": "^3.2.4",
      "eslint": "^9.37.0",
      "jsdom": "^27.0.0",
      "prettier": "^3.6.2",
      "typescript": "^5.9.3",
      "vite": "^7.1.9",
      "vite-plugin-dts": "^4.5.4",
      "vite-tsconfig-paths": "^5.1.4",
      "vitest": "^3.2.4"
   },
   "dependencies": {
      "@salt-ds/core": "^1.50.0",
      "@salt-ds/countries": "^1.4.21",
      "@salt-ds/icons": "^1.14.0",
      "@salt-ds/theme": "^1.33.0"
   }
}
